{
  "Context": {
    "CustomerName": "<SET_CUSTOMER_NAME>"
  },
  "Pfx": {
    "Path": "C:\\_install",
    "Password": "",
    "AutoSelectLatest": true
  },
  "BusinessCentral": {
    "UseLatestModule": true
  },
  "IIS": {
    "SiteName": "Microsoft Dynamics 365 Business Central Web Client",
    "RestartAfterUpdate": true
  },
  "Logging": {
    "Enabled": true,
    "Path": "logs",
    "RetentionDays": 90
  },
  "Notifications": {
    "EnableWebhook": true,
    "Webhooks": {
      "Customer": "<SET_CUSTOMER_WEBHOOK_URL>",
      "Internal": "<SET_INTERNAL_WEBHOOK_URL>"
    },
    "CertificateExpiry": {
      "NotifyBeforeDays": 365,
      "EnableCustomerNotification": true
    }
  },
  "Heartbeat": {
    "Enabled": true,
    "Url": "<SET_AZURE_HEARTBEAT_URL>",
    "TimeoutSec": 10,
    "NotifyInternalOnFailure": true
  }
}
